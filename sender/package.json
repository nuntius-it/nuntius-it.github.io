{
  "name": "nuntius-sender",
  "productName": "Nuntius",
  "version": "0.2.0-beta.2",
  "description": "Annunci WhatsApp per le parrocchie: gestione gruppi, liste e invio",
  "main": "main.js",
  "author": "Nuntius",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "NUNTIUS_DEV_URL=http://localhost:5173 electron .",
    "ui": "npm --prefix ../webapp run build && rm -rf renderer-app && cp -R ../webapp/dist renderer-app",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8"
  },
  "overrides": {
    "node-gyp": "^11.4.2"
  }
}
